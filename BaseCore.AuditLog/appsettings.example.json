{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "MongoDB": {
    "ConnectionString": "mongodb://[YOUR_IP]:[PORT]",
    "Database": "AuditLogDb"
  },
  "AppSettings": {
    "Secret": "[YOUR_SECRET_KEY]",
    "IsProduction": false
  },
  "Redis": {
    "ConnectionString": "[YOUR_REDIS_IP]:[PORT]",
    "DefaultDatabase": 7,
    "InstanceName": "PLM_",
    "CachingExpireMinute": 15
  },
  "Cors": {
    "WithOrigin": "http://localhost:4200"
  }
}
